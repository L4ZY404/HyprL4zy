# HyprL4zy repository ignore rules

# Machine-specific configuration / runtime preferences
home/.config/hypr/local.conf
home/.config/quickshell/hyprl4zy/settings.json
!home/.config/hypr/local.example.conf
!home/.config/quickshell/hyprl4zy/settings.example.json

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Caches and runtime files
**/.cache/
**/__pycache__/
*.pyc
*.pyo
*.log
*.pid
*.swp
*.swo
*~

# Dependencies and build output
node_modules/
dist/
build/
coverage/

# Backups and temporary files
*.bak
*.backup
*.old
*.orig
backups/
backup/
tmp/
temp/

# Generated archives and checksums
*.tar.gz
*.tgz
*.zip
*.7z
*.sha256

# Editor / OS metadata
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini
